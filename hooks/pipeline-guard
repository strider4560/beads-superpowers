#!/usr/bin/env bash
set -u
# pipeline-guard — PreToolUse hard deny for Bash|Write|Edit|NotebookEdit.
# Exit 2 with a one-line stderr reason blocks the tool call; exit 0 allows it.
#
# Two phases, and the ordering is the design:
#
#   Phase 1 — activation. Dependency-free: pure file-existence tests, no jq, no
#   bundle root, stdin not even read. This hook fires on EVERY Bash, Write and
#   Edit call in every project that installs the plugin, so a project that does
#   not use the pipeline must cost nothing and must never be blocked by a
#   missing dependency.
#
#   Phase 2 — armed. Strict fail-closed: a missing dependency, unreadable stdin
#   or broken state denies the call rather than waving it through.
#
# What this guard enforces (the agent-authority model, 2026-08-21):
#
#   Install integrity — the anchored install is verified against its record
#   before anything from it is trusted or sourced.
#   Rule D — the pipeline state directory and the install surface are not
#            model-writable, whatever is calling.
#   Rule S — subagent authority: a subagent does not manage beads, durable
#            knowledge, or the plan of record. Those are the orchestrating
#            session's alone. The main session is unrestricted here.
#
# What this guard deliberately does NOT do: key any decision on the session's
# model id, size, or effort. The former session-model tier wall (Rules A/B/C,
# resolve_session_tier, tier-assert) bricked whole sessions whenever the
# harness reported a model spelling the tier-map did not list, and the
# enforcement point never even receives a model field on PreToolUse. Subagent
# detection is `has("agent_id")` on the payload — the ADR-0061 amendment's
# standing rule — which is harness-supplied at dispatch and has no vocabulary
# to go stale. agent_type rides along for the deny message only: keying
# enforcement on the NAME would reintroduce the unmapped-key failure the tier
# wall was removed for.

state_dir=".internal/pipeline"

# --- Phase 1 ----------------------------------------------------------------
[ -f "$state_dir/session.json" ] || [ -f "$state_dir/tier-assert" ] || exit 0

# --- Phase 2 ----------------------------------------------------------------
deny() { echo "pipeline-guard: $1" >&2; exit 2; }

# normalize_path <path> — lexical normalization of a tool-supplied file_path,
# printing the cleaned ABSOLUTE path. ONE helper with three callers — Rule D's
# state-directory half, Rule D's install-surface half and Rule S — because all
# three ask the same question — where does this write land? — and none can
# answer it from the raw string:
#   * The Write and Edit tools document file_path as "must be absolute", so the
#     value that actually arrives is /home/u/proj/docs/x.md, not docs/x.md. A
#     deny-list anchored to a relative path matches none of it.
#   * `..`, `//` and a leading `./` let one file be spelled many ways, so a
#     substring or prefix test over the raw string is bypassed by rewriting the
#     spelling: .internal/specs/../pipeline/tier-assert reaches the state file.
# Purely lexical — no realpath, no stat. The file a Write creates does not exist
# yet, so there is nothing on disk to canonicalize, and symlink resolution would
# answer a different question than the one asked.
# Residual, accepted: a PRE-EXISTING symlink into a denied directory defeats
# the Write/Edit halves — .internal/specs -> .internal/pipeline makes a write
# to .internal/specs/tier-assert normalize to itself and Rule D does not fire.
normalize_path() {
  local raw="$1" abs out seg
  case "$raw" in
    /*) abs="$raw" ;;
    *)  abs="$PWD/$raw" ;;
  esac
  # Split on / with parameter expansion only. `read -a` would stop at the first
  # newline, and a file_path may legally contain one — `docs/a<LF>/../../src/y.js`
  # resolves to a source file while its first line reads as an allowed docs/ path.
  out=""
  while [ -n "$abs" ]; do
    seg="${abs%%/*}"
    if [ "$abs" = "$seg" ]; then abs=""; else abs="${abs#*/}"; fi
    case "$seg" in
      ''|.) ;;
      ..)   out="${out%/*}" ;;
      *)    out="$out/$seg" ;;
    esac
  done
  printf '%s' "$out"
}

command -v jq >/dev/null || deny "jq is required once the pipeline is active"

payload="$(cat)" || deny "cannot read the PreToolUse payload"
jq -e . >/dev/null 2>&1 <<< "$payload" || deny "PreToolUse payload is not valid JSON"

tool="$(jq -r '.tool_name // empty' <<< "$payload")"
cmd="$(jq -r '.tool_input.command // empty' <<< "$payload")"
# NotebookEdit is in the Write|Edit class of Rules D and S — it writes a file the
# same way they do — but it names its path `notebook_path`, not `file_path`
# (verified against the shipped tool schema). Both spellings are read here so
# the rules below stay path-shaped and tool-agnostic.
path="$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<< "$payload")"
nabs="$(normalize_path "$path")"
# The project-relative spelling, for the rules that read project paths. A path
# outside the project keeps its absolute form and so matches no relative pattern.
npath="$nabs"
case "$nabs" in
  "$PWD")   npath="" ;;
  "$PWD"/*) npath="${nabs#"$PWD"/}" ;;
esac

# The live session id, used ONLY as the integrity-check cache key below — never
# as an authority signal. THE SHARED SESSION-ID RULE survives from the old
# design: every actor folds a session id through `tr -cd 'a-zA-Z0-9_-' | cut
# -c1-64` before it stores or compares it (hooks/session-start when it RECORDS
# the id); the fold keeps the marker filename stable and path-safe.
live_sid="$(jq -r '.session_id // empty' <<< "$payload")"
live_sid="$(printf '%s' "$live_sid" | tr -cd 'a-zA-Z0-9_-' | cut -c1-64)"

# --- install integrity (D3, R4-004) -----------------------------------------
# bundle-root.sh is sourced HERE, ahead of the rules, because it owns the fixed
# anchor and record spellings Rule D reads.
# It also owns verify_record — and it is itself a manifest entry — so sourcing it
# and then calling the function it defines would be a check that trusts its own
# subject: appending `verify_record() { return 0; }` to the anchored copy would
# disable the check that catches the append. The file is therefore hashed
# against the record BEFORE it is sourced, and only then sourced.
# The anchor and record are spelled as literals here rather than imported,
# because the file that owns those spellings is exactly what may not be trusted
# yet. They are fixed literals for the reason bundle-root.sh states — four actors
# resolving env vars in four process trees — so restating them cannot drift
# without the record reading as absent, which is already a hard deny.
# Only a manifest-backed record makes a claim about this file. An absent,
# unreadable or declared-advisory record claims nothing here; verify_record below
# already denies or stands down exactly as each of those postures requires.
bsp_anchor_lit="${HOME%/}/.agents/beads-superpowers"
bsp_record_lit="${HOME%/}/.local/state/beads-superpowers/record.json"
bundle_lib="$(dirname "$0")/../scripts/pipeline/bundle-root.sh"
if { [ -e "$bsp_anchor_lit" ] || [ -L "$bsp_anchor_lit" ]; } && [ -r "$bsp_record_lit" ] &&
   [ "$(jq -r '.posture // empty' "$bsp_record_lit" 2>/dev/null)" = "manifest-backed" ]; then
  # WHICH bundle-root.sh the record's hash is a claim about: the copy under
  # record.target, never "whatever sits next to this hook". The two coincide
  # only when this guard is itself running out of the attested root. When it is
  # not — two supported channels installed at skewed versions, or a
  # repo-relative/dev invocation — the sibling is a file the record says nothing
  # about, and comparing it against the record's hash denies every tool call
  # with a remedy that re-attests the OTHER root and so never clears (verified:
  # the plugin-channel guard against a scripted-tier record). record.target is
  # also the root verify_record hashes the rest of the manifest under, so this
  # keeps one subject for the whole check. CRITICAL-2's property is unchanged:
  # whatever is about to be sourced is hashed first, and an attested copy that
  # is missing or unreadable denies rather than falling back to the sibling.
  rec_target="$(jq -r '.target // empty' "$bsp_record_lit" 2>/dev/null)" || rec_target=""
  if [ -n "$rec_target" ]; then
    rec_tcanon="$(cd "$rec_target" 2>/dev/null && pwd -P)" || rec_tcanon=""
    [ -n "$rec_tcanon" ] || rec_tcanon="$rec_target"
    own_libdir="$(cd "$(dirname "$0")/../scripts/pipeline" 2>/dev/null && pwd -P)" ||
      own_libdir=""
    case "$own_libdir" in
      "$rec_tcanon"|"$rec_tcanon"/*) ;;   # inside the attested root: sibling IS the copy
      *) bundle_lib="$rec_tcanon/scripts/pipeline/bundle-root.sh"
         [ -r "$bundle_lib" ] ||
           deny "install integrity: the attested scripts/pipeline/bundle-root.sh is missing or unreadable under $rec_tcanon — re-run beads-superpowers' install.sh to re-attest the root"
         # VERSION SKEW. Reaching this branch means the hook and the library it
         # is about to source come from two different installed channels. That
         # is supported — the block above fixes the attested copy as the right
         # subject to hash — but only while both halves are the same release.
         # They are two halves of one contract, and v0.18.0 priced the split:
         # its guard called resolve_session_tier, the agent-authority rework
         # deleted that function from bundle-root.sh, and a v0.18.0 plugin cache
         # against a post-rework install root killed every Bash, Write and Edit
         # call in the session with a bash "command not found" and no remedy
         # anywhere in the line. Comparing versions BEFORE the source turns that
         # into a deny that names the fix, instead of an undefined function
         # three lines later.
         # Either side missing a version stands the check down rather than
         # denying. A record written before this check existed carries no version,
         # channel with no package.json beside its hooks/ is a shape this check
         # cannot speak about; denying on silence would brick exactly the
         # installs it exists to rescue. The manifest hashes above stay the
         # tamper control — this separates two honest halves of different ages,
         # and it is forward-only by construction, since only a side carrying
         # the check can report the skew.
         # A git checkout is a development tree, and it is SUPPOSED to run
         # ahead of the installed root: CLAUDE.md has maintainers symlink the
         # plugin cache straight at the repo, so every version bump puts the two
         # out of step until the next install.sh. Denying there would brick the
         # documented maintainer workflow on every bump — the same over-block
         # the session-model wall was retired for, reintroduced one level down.
         # `-e`, not `-d`: a linked worktree spells .git as a file.
         if [ ! -e "$(dirname "$0")/../.git" ]; then
           own_ver="$(jq -r '.version // empty' "$(dirname "$0")/../package.json" 2>/dev/null)" || own_ver=""
           rec_ver="$(jq -r '.version // empty' "$bsp_record_lit" 2>/dev/null)" || rec_ver=""
           if [ -n "$own_ver" ] && [ -n "$rec_ver" ] && [ "$own_ver" != "$rec_ver" ]; then
             deny "install skew: this hook is beads-superpowers $own_ver but the attested install root is $rec_ver — the two are halves of one contract and must be the same release; refresh the stale channel (plugin: 'claude plugin update beads-superpowers'; scripted: re-run install.sh)"
           fi
         fi ;;
    esac
  fi
  want_lib_hash="$(jq -r '.hashes["scripts/pipeline/bundle-root.sh"] // empty' \
                      "$bsp_record_lit" 2>/dev/null)"
  if command -v sha256sum >/dev/null 2>&1; then
    got_lib_hash="$(sha256sum "$bundle_lib" 2>/dev/null)" || got_lib_hash=""
  elif command -v shasum >/dev/null 2>&1; then
    got_lib_hash="$(shasum -a 256 "$bundle_lib" 2>/dev/null)" || got_lib_hash=""
  else
    deny "install integrity: no sha256 tool on PATH (sha256sum or shasum), so scripts/pipeline/bundle-root.sh cannot be verified before it is sourced"
  fi
  got_lib_hash="${got_lib_hash%% *}"
  # An empty want is a manifest-backed record that attests nothing about this
  # file — a licence to source it unchecked, which is the deny this exists for.
  [ -n "$want_lib_hash" ] && [ "$got_lib_hash" = "$want_lib_hash" ] ||
    deny "install integrity: scripts/pipeline/bundle-root.sh does not match its recorded hash — restore the file, or re-run beads-superpowers' install.sh to re-attest the root"
fi
# shellcheck source=scripts/pipeline/bundle-root.sh
. "$bundle_lib" 2>/dev/null ||
  deny "cannot load scripts/pipeline/bundle-root.sh"

# verify_record's four failure states — record absent under a present anchor, a
# hash mismatch, an unreadable record, no hashing tool — deny at exit 2 on this
# surface, because exit 1 does not block a PreToolUse call. This runs inside
# Phase 2, AFTER the Phase-1 activation early exit, so an unarmed project is
# never denied by a corrupted record (R4-004).
# Hashing every gate file on every Bash/Write/Edit call would be a fork storm on
# the hot path, so a PASS is cached once per session, keyed on the record's mtime
# — session-start's marker pattern. Only a pass is cached: a failure must keep
# denying on every call. Disclosed consequence: detection is between-call, not
# per-call, which is the same property the manifest already has between
# maintainer runs.
integrity_marker() { # -> the per-session, per-record-mtime marker path, or ""
  local mt dir
  mt="$(stat -c %Y "$RECORD_PATH" 2>/dev/null)" || mt=""
  [ -n "$mt" ] || mt="$(stat -f %m "$RECORD_PATH" 2>/dev/null)" || mt=""
  # No mtime (no record) and no live id are both "nothing stable to key on":
  # verify every call rather than cache under a key that cannot be invalidated.
  [ -n "$mt" ] && [ -n "$live_sid" ] || return 0
  dir="${XDG_RUNTIME_DIR:-/tmp}/beads-superpowers-$(id -u 2>/dev/null || echo u)"
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null || return 0
  # The id reaches the filename, so everything outside a safe set is folded away
  # rather than trusted to be path-shaped.
  printf '%s/integrity-%s-%s' "$dir" "${live_sid//[!A-Za-z0-9_-]/_}" "$mt"
}
integrity_mark="$(integrity_marker)"
# A planted symlink is refused rather than followed: the marker is a cache slot,
# not a capability, and one we do not own is one we do not trust.
if [ -z "$integrity_mark" ] || [ -L "$integrity_mark" ] || [ ! -f "$integrity_mark" ]; then
  if ! integrity_why="$(verify_record "$(dirname "$0")/../scripts/pipeline" 2>&1)"; then
    # verify_record may print a NOTE before its ERROR; a PreToolUse deny reason
    # is one line, so only the last line — the ERROR — survives.
    integrity_why="${integrity_why##*$'\n'}"
    deny "install integrity: ${integrity_why#ERROR: }"
  fi
  # noclobber, so the marker is CREATED or nothing happens: it refuses to write
  # through an existing entry, symlink included, which is the same posture
  # session-start takes with its own dedup marker.
  [ -n "$integrity_mark" ] && ( set -C; : > "$integrity_mark" ) 2>/dev/null
fi

# --- Rule D: the pipeline state directory is not model-writable --------------
# The state directory arms this guard, so anything that can write it can also
# disarm or re-arm the guard underneath the session. Denied for every caller,
# orchestrator included.
# The Write/Edit half is the reliable one: it inspects a single path the harness
# hands us and requires it to RESOLVE inside the state directory — matched after
# normalize_path, component-anchored. A substring test would be bypassed by
# .internal/specs/../pipeline/session.json and would also over-deny
# .internal/pipeline-notes.md.
# The Bash half is a substring test over a shell command string and is therefore
# best-effort only — an adversarial command can reach the directory without the
# literal path ever appearing (variables, encoding, a helper script). Do not read
# the Bash half as a boundary; it catches the obvious redirect, and it stays a
# bare substring test on purpose: narrowing it would only shrink what it catches.
#
# Decision (beads-superpowers-cv6.19, maintainer ruling 2026-08-21): the Bash
# half's over-match is INTENDED, kept as-is. A command that only MENTIONS the
# state-dir path in prose (a `bd note` quoting it while describing a remedy)
# or only READS it (`ls`, `cat`) is denied exactly like a command that writes
# it, because the substring test cannot tell "prose" or "read" from "write"
# inside a shell command string. Trade-off accepted: an agent must reword a
# note or command that quotes the state-dir path, rather than being denied
# only on an actual write. Reason: parsing intent out of a Bash command
# string is precisely where a matcher gets bypassed — a narrower rule that
# tried to separate "read/mention" from "write" would itself become the
# thing a write gets disguised as. tests/pipeline/test-pipeline-guard.sh pins
# this so a future well-meaning narrowing fails loudly.
# (This bead was filed against an OLDER guard that also had a Rule C — denying
# any Bash command merely mentioning `tier-gate.sh --assert` — with the
# identical trade-off. Rule C, and the --assert flag it matched, were retired
# entirely in the 2026-08-21 agent-authority rework (commit 5813616, "retire
# the session-model tier wall"); no rule named C exists in this file any more,
# so this decision documents Rule D only.)
case "$tool" in
  Write|Edit|NotebookEdit) case "$npath" in
    .internal/pipeline|.internal/pipeline/*|*/.internal/pipeline|*/.internal/pipeline/*)
      deny "the pipeline state directory is not model-writable (Rule D)" ;; esac ;;
  Bash) case "$cmd" in *".internal/pipeline"*)
    deny "the pipeline state directory is not model-writable (Rule D)" ;; esac ;;
esac

# Rule D's second half: the INSTALL surface (SEC-D3-RULE-D). Anything that can
# edit a gate, a hook, an anchor entry or the integrity record rewrites the
# control that is judging the call — self-authorization one level up.
# The match set is deliberately BOUNDED, and the bound is the anchor SPELLING:
# the two anchor entries themselves, the script and hook files reached THROUGH an
# anchor, great_cto's shared/ policy data, and the integrity record's directory.
# It is not "and their targets" — a development clone reached as the working
# project is ordinary source, and an unbounded rule would brick every clone on
# the machine. Residual, stated: with the clone as the working project, editing
# its own gates is not denied, which is consistent with dev-clone roots being
# advisory.
# `scripts/`, not `scripts/pipeline/`: control files live outside the pipeline/
# subdirectory too, and a bound that stops at pipeline/ leaves them
# model-writable through the anchor. great_cto's shared/ is named because
# dispatch policy (tier-map roles, review schemas) is READ from it.
# The great_cto anchor is spelled here rather than imported because
# bundle-root.sh keeps it local to resolve_bundle_root; both spellings are fixed
# literals for the reason stated there — four actors resolve env vars in four
# process trees, so an env-derived path would read as a different anchor.
gc_anchor="${HOME%/}/.agents/great_cto"
record_dir="${RECORD_PATH%/*}"
case "$tool" in
  Write|Edit|NotebookEdit) case "$nabs" in
    "$gc_anchor"|"$BSP_ANCHOR"|"$record_dir"|"$record_dir"/*|\
    "$gc_anchor"/scripts/*|"$gc_anchor"/hooks/*|"$gc_anchor"/shared/*|\
    "$BSP_ANCHOR"/scripts/*|"$BSP_ANCHOR"/hooks/*)
      deny "the beads-superpowers install surface is not model-writable (Rule D)" ;; esac ;;
esac

# --- Rule S: subagent authority (2026-08-21) ---------------------------------
# A subagent does not manage beads, durable knowledge, or the plan of record —
# those belong to the orchestrating session, which dispatched the subagent and
# owns the plan it is executing. The subagent's remedy is always the same:
# surface the need to the orchestrator in its report instead of mutating state.
#
# Subagent detection: `has("agent_id")` on the payload — harness-supplied at
# dispatch, present on every hook event inside a subagent, absent on the main
# thread. Never keyed on agent_type/name (a table of names goes stale; absence
# of a name must not grant authority) and never on an env var (model-settable).
#
# Like the retired Rule A, the Bash half is best-effort defence-in-depth over a
# command string, not a boundary — a helper script or expansion can evade it.
# The per-agent `tools` frontmatter and the prompt-template contracts remain the
# other layers. A false-positive deny costs the subagent one command and tells
# it exactly what to do instead.
if jq -e 'has("agent_id")' >/dev/null 2>&1 <<< "$payload"; then
  agent_type="$(jq -r '.agent_type // "subagent"' <<< "$payload")"
  case "$tool" in
    Bash)
      # `$padded` is the command with one space added at each end, so the token
      # patterns need no ^/$ anchor — a plain character class is the same regex
      # on every libc. It is what rejects `abd` and `bd-helper`.
      padded=" $cmd "
      mex_write_re='[^[:alnum:]_-]mex[[:space:]]+(log|setup|sync|config)[^[:alnum:]_-]'
      # Every bd invocation in the command is inspected: the token after each
      # `bd` must be in the benign set — the reads a reviewer legitimately
      # runs, plus `note`, the one write great_cto's implementation contract
      # grants a subagent (notes on its own task beads). Anything else —
      # create, close, update, import, or a global flag like -C sitting ahead
      # of the subcommand — denies. Grammar-guessing bd's mutation surface
      # failed repeatedly under the old Rule A, so this is an ALLOW-set: an
      # unknown or unparsable spelling denies rather than passes.
      bd_scan="$padded" bd_bad=0
      while [[ "$bd_scan" =~ [^[:alnum:]_-]bd[[:space:]]+([[:alnum:]_-]+) ]]; do
        case "${BASH_REMATCH[1]}" in
          note|show|list|ready|query|human|prime|help|--help) ;;
          *) bd_bad=1; break ;;
        esac
        bd_scan="${bd_scan#*"${BASH_REMATCH[0]}"}"
      done
      if [ "$bd_bad" -eq 1 ]; then
        deny "beads are managed by the orchestrating session — a subagent only reads beads or runs 'bd note' on its own task; report anything else in your subagent report ('$agent_type', Rule S)"
      fi
      if [[ "$padded" =~ $mex_write_re ]]; then
        deny "durable knowledge is written by the orchestrating session only — surface the lesson in your subagent report instead of writing mex ('$agent_type', Rule S)"
      fi
      ;;
    Write|Edit|NotebookEdit)
      case "$npath" in
        .mex/*|*/.mex/*)
          deny "durable knowledge (.mex/) is written by the orchestrating session only — surface it in your subagent report ('$agent_type', Rule S)" ;;
        plans/*|.internal/plans/*|.internal/specs/*|.worktrees/*/plans/*)
          deny "the plan of record is managed by the orchestrating session only — report the needed plan change instead of editing it ('$agent_type', Rule S)" ;;
      esac
      ;;
  esac
fi

exit 0
